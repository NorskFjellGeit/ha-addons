#!/usr/bin/with-contenv bashio
set -Eeuo pipefail

bashio::log.info "Starting FFMpeg with auto-reconnect…"

# --- Config ---
bashio::config.require 'camera_url'
CAMERA_URL="$(bashio::config 'camera_url')"
OUT_URL="http://127.0.0.1:8091/feed.ffm"

# Backoff between retries
backoff=1        # seconds
max_backoff=10   # cap the wait

# Optional: font example (uncomment if you overlay text)
# FONT="/usr/share/fonts/noto/NotoSansMono-Regular.ttf"

while true; do
  bashio::log.info "Launching ffmpeg… (backoff=${backoff}s)"
  /usr/local/bin/ffmpeg -hide_banner -loglevel warning \
    -rtsp_transport tcp -rtsp_flags prefer_tcp \
    -rw_timeout 5000000 \                      # if unsupported on your build, use: -stimeout 5000000
    -use_wallclock_as_timestamps 1 \
    -i "${CAMERA_URL}" \
    -vsync 1 \
    -af aresample=async=1:min_hard_comp=0.100 \  # replaces deprecated -async 1
    "${OUT_URL}"

  code=$?
  bashio::log.warning "ffmpeg exited with code ${code}. Retrying in ${backoff}s…"
  sleep "${backoff}"
  (( backoff < max_backoff )) && backoff=$(( backoff * 2 ))
done
